{
  "name": "react-native-facefusion",
  "version": "0.1.0",
  "description": "React Native TurboModule for on-device face swapping on Qualcomm Hexagon NPUs. Runs fully offline on the phone, no server and no uploads.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-facefusion-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "TROUBLESHOOTING.md",
    "scripts/fetch-upstream.sh",
    "scripts/check-tarball.sh",
    "patches",
    "third_party/facefusion-mobile/NOTICE",
    "!android/src/main/jniLibs",
    "!android/src/main/cpp/include/QNN",
    "!third_party/facefusion-mobile/cpp",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "npm run --workspace=example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "postinstall": "./scripts/fetch-upstream.sh || echo 'react-native-facefusion: could not auto-fetch the upstream C++ engine (see the error above). Run ./node_modules/react-native-facefusion/scripts/fetch-upstream.sh by hand before building Android -- most likely cause is no network/git at install time.'",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepublishOnly": "./scripts/check-tarball.sh"
  },
  "keywords": [
    "react-native",
    "android",
    "face-swap",
    "npu",
    "qualcomm",
    "on-device-ml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipitsaad/facefusion-rn.git"
  },
  "author": "Saad <saad.saad737@gmail.com> (https://github.com/shipitsaad)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shipitsaad/facefusion-rn/issues"
  },
  "homepage": "https://github.com/shipitsaad/facefusion-rn#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "FacefusionSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.facefusion"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
